{
  "name": "kiosk-web",
  "version": "0.1.0",
  "private": true,
  "description": "The Chora kiosk edition's front end for the NUS-ISS Apollo showcase room (ADR-259, K97).",
  "packageManager": "npm@11.9.0",
  "scripts": {
    "ng": "ng",
    "start:fixtures": "KIOSK_WEB_API_TARGET=http://127.0.0.1:18301 ng serve --host 127.0.0.1 --port 18300",
    "start:stack": "KIOSK_WEB_API_TARGET=http://127.0.0.1:8093 ng serve --host 127.0.0.1 --port 18300",
    "fixtures": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON dev/world/make-fixtures.mjs pictures && node dev/fixture-server.mjs --port 18301",
    "fixtures:write": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON dev/world/make-fixtures.mjs write",
    "fixtures:check": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON dev/world/make-fixtures.mjs check",
    "build": "ng build",
    "build:offline": "node tools/offline-build.mjs",
    "test": "node --max-old-space-size=6144 node_modules/vitest/vitest.mjs run",
    "test:coverage": "node --max-old-space-size=6144 node_modules/vitest/vitest.mjs run --coverage",
    "test:tools": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test tools/*/*.test.mjs dev/*.test.mjs dev/*/*.test.mjs",
    "gates": "node tools/gates/offline-gate.mjs dist/kiosk-web/browser && node tools/gates/no-fixture-gate.mjs dist/kiosk-web/browser && node tools/gates/papers-gate.mjs dist/kiosk-web/browser papers/papers.sha256",
    "e2e": "playwright test",
    "strings": "node tools/strings/extract-mockup-strings.mjs",
    "strings:check": "node tools/strings/extract-mockup-strings.mjs --check",
    "copies:check": "node tools/production/copies.mjs check",
    "mockup:check": "node tools/strings/extract-mockup-strings.mjs --check && node tools/styles/extract-mockup-css.mjs --check && node tools/icons/extract-mockup-icons.mjs --check && node tools/art/extract-mockup-art.mjs --check"
  },
  "dependencies": {
    "@angular/common": "21.2.21",
    "@angular/compiler": "21.2.21",
    "@angular/core": "21.2.21",
    "@angular/forms": "21.2.21",
    "@angular/platform-browser": "21.2.21",
    "@angular/router": "21.2.21",
    "@fontsource-variable/inter": "5.2.8",
    "@ngx-translate/core": "17.0.0",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@analogjs/vite-plugin-angular": "2.7.0",
    "@analogjs/vitest-angular": "2.7.0",
    "@angular/build": "21.2.22",
    "@angular/cli": "21.2.22",
    "@angular/compiler-cli": "21.2.21",
    "@angular/platform-browser-dynamic": "21.2.21",
    "@playwright/test": "1.62.1",
    "@types/node": "26.3.0",
    "@vitest/coverage-v8": "4.1.11",
    "axe-core": "4.13.0",
    "jsdom": "28.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.6",
    "vitest": "4.1.11"
  }
}
